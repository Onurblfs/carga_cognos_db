# ============================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado (ja esta no .gitignore).
# ============================================================

# ----- Cognos -----
# URL base do Cognos Analytics (sem barra no final)
# Ex.: https://cognos.suaempresa.com.br/ibmcognos
COGNOS_URL=https://SEU_SERVIDOR/ibmcognos

# Namespace de autenticacao do Cognos (CAMNamespace)
COGNOS_NAMESPACE=LDAP

# Usuario e senha de rede/Cognos
COGNOS_USUARIO=seu_usuario
COGNOS_SENHA=sua_senha

# ----- Banco de dados -----
# Opcao 1 (recomendada): string de conexao SQLAlchemy completa.
# Exemplos:
#   SQL Server : mssql+pyodbc://usuario:senha@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server
#   SQL Server (autenticacao Windows):
#                mssql+pyodbc://@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
#   PostgreSQL : postgresql+psycopg2://usuario:senha@servidor:5432/banco
#   Oracle     : oracle+oracledb://usuario:senha@servidor:1521/?service_name=servico
DB_CONNECTION_STRING=mssql+pyodbc://usuario:senha@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server

# Schema padrao onde as tabelas serao criadas/gravadas (opcional)
DB_SCHEMA=dbo

# ----- Geral -----
# Pasta local onde os arquivos baixados do Cognos ficam salvos
PASTA_DOWNLOADS=downloads
