# ============================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser commitado (ja esta no .gitignore).
# ============================================================

# ----- Automacao de download (att_cognos_pbi) -----
# Pasta onde o repositorio att_cognos_pbi esta clonado na sua maquina
ATT_COGNOS_DIR=C:\Users\n5919189\OneDrive - Claro SA\FINANCEIRO\Github\att_cognos_pbi

# ----- Banco de dados -----
# String de conexao SQLAlchemy completa. Exemplos:
#   SQL Server : mssql+pyodbc://usuario:senha@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server
#   SQL Server (autenticacao Windows):
#                mssql+pyodbc://@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
#   PostgreSQL : postgresql+psycopg2://usuario:senha@servidor:5432/banco
#   Oracle     : oracle+oracledb://usuario:senha@servidor:1521/?service_name=servico
DB_CONNECTION_STRING=mssql+pyodbc://usuario:senha@SERVIDOR/BANCO?driver=ODBC+Driver+17+for+SQL+Server

# Schema padrao onde as tabelas serao gravadas (opcional)
DB_SCHEMA=dbo
